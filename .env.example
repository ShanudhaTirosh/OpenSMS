# OpenSMS environment variables (PLACEHOLDERS ONLY - never commit real values).
#
# These are read by the gateway on desktop/development runs and in CI. The Android app cannot read
# environment variables: on a phone the defaults below apply (there is no in-app setting for them yet).

# Allow the simulated SMS provider outside Android (development/CI only; nothing is ever sent). 0 or 1.
OPENSMS_ALLOW_SIMULATION=0

# Serve /docs, /openapi.json, /llms.txt and /docs/markdown without authentication. 0 or 1.
OPENSMS_PUBLIC_DOCS=0

# Messages each API key may send per minute (0 disables the limit).
OPENSMS_SEND_RATE_PER_MIN=300

# Seconds POST /sms/ waits for the hand-off before answering 202 "queued".
OPENSMS_SUBMIT_WAIT_SECONDS=15

# tools/ui_walkthrough.py: where screenshots are written.
OPENSMS_SHOT_DIR=/tmp/opensms-shots

# --- Release signing (GitHub Actions SECRETS, not environment variables; listed here for reference) ---
# ANDROID_KEYSTORE_B64=<base64 of release.keystore>
# ANDROID_KEYSTORE_PASSWORD=<keystore password>
# ANDROID_KEY_ALIAS=<key alias>
# ANDROID_KEY_PASSWORD=<key password>
