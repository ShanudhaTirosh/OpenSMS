+"""Stage 7/8: updater trust + checksum, single version source."""
+import hashlib, re, sys
+from pathlib import Path
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+APP = ROOT / "app"
+sys.path.insert(0, str(APP))
+
+from services import updateMgr as um
+from services.updateMgr import UpdateManager, is_trusted_download_url
+
+REPO = um.GITHUB_REPO
+GOOD = f"https://github.com/{REPO}/releases/download/v9.9.9/OpenSMS-arm64.apk"
+
+
+@pytest.mark.parametrize("url,ok", [
+    (GOOD, True),
+    (GOOD.upper().replace("HTTPS", "https"), True),             # host and owner/repo are case-insensitive
+    (f"http://github.com/{REPO}/releases/download/v1/a.apk", False),                 # not https
+    (f"https://github.com.evil.example/{REPO}/releases/download/v1/a.apk", False),    # look-alike host
+    (f"https://evil.example/{REPO}/releases/download/v1/a.apk", False),
+    ("https://github.com/someone-else/OpenSMS/releases/download/v1/a.apk", False),   # another repository
+    (f"https://github.com/{REPO}/archive/main.zip", False),                           # not a release asset
+    (f"https://user:pw@github.com/{REPO}/releases/download/v1/a.apk", False),         # embedded credentials
+    (f"https://github.com:8443/{REPO}/releases/download/v1/a.apk", False),            # unusual port
+    (f"https://github.com:443/{REPO}/releases/download/v1/a.apk", True),
+    ("", False), (None, False), ("not a url", False), ("file:///sdcard/a.apk", False),
+])
+def test_trusted_download_url(url, ok):
+    assert is_trusted_download_url(url) is ok
+
+
+class FakeResp:
+    def __init__(self, status=200, payload=None, chunks=(), text=""):
+        self.status_code, self._payload, self._chunks, self.text = status, payload, chunks, text
+        self.headers = {"content-length": str(sum(len(c) for c in chunks))}
+    def json(self): return self._payload
+    def raise_for_status(self): pass
+    def iter_content(self, chunk_size=0): return iter(self._chunks)
+    def __enter__(self): return self
+    def __exit__(self, *a): return False
+
+
+def release(assets):
+    return {"tag_name": "v9.9.9", "name": "x", "body": "notes", "html_url": "u", "published_at": "t", "assets": assets}
+
+
+def asset(name, url=None, digest=None, size=10):
+    a = {"name": name, "browser_download_url": url or f"https://github.com/{REPO}/releases/download/v9.9.9/{name}", "size": size}
+    if digest: a["digest"] = digest
+    return a
+
+
+SHA = "ab" * 32
+
+
+def test_update_check_uses_github_digest(monkeypatch):
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(payload=release([asset("OpenSMS.apk", digest="sha256:" + SHA)])))
+    r = UpdateManager.check_for_updates("0.4.0")
+    assert r["has_update"] and r["apk_url"].endswith("OpenSMS.apk") and r["apk_sha256"] == SHA
+
+def test_update_check_falls_back_to_sidecar(monkeypatch):
+    payload = release([asset("OpenSMS.apk"), asset("OpenSMS.apk.sha256")])
+    def fake_get(url, **k):
+        return FakeResp(text=f"{SHA}  OpenSMS.apk\n") if url.endswith(".sha256") else FakeResp(payload=payload)
+    monkeypatch.setattr(um.requests, "get", fake_get)
+    assert UpdateManager.check_for_updates("0.4.0")["apk_sha256"] == SHA
+
+def test_update_check_without_checksum_reports_none(monkeypatch):
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(payload=release([asset("OpenSMS.apk")])))
+    assert UpdateManager.check_for_updates("0.4.0")["apk_sha256"] is None
+
+def test_update_check_drops_untrusted_asset_url(monkeypatch):
+    bad = asset("OpenSMS.apk", url="https://evil.example/OpenSMS.apk", digest="sha256:" + SHA)
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(payload=release([bad])))
+    r = UpdateManager.check_for_updates("0.4.0")
+    assert r["success"] and r["apk_url"] is None
+
+def test_malformed_digest_is_ignored(monkeypatch):
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(payload=release([asset("OpenSMS.apk", digest="sha256:nothex")])))
+    assert UpdateManager.check_for_updates("0.4.0")["apk_sha256"] is None
+
+
+def test_download_verifies_checksum(monkeypatch, tmp_path):
+    data = [b"abc" * 1000, b"def" * 500]
+    good = hashlib.sha256(b"".join(data)).hexdigest()
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(chunks=data))
+    dest = tmp_path / "u.apk"
+    r = UpdateManager.download_apk(GOOD, str(dest), expected_sha256="sha256:" + good)
+    assert r["success"] and r["verified"] is True and r["sha256"] == good and dest.exists()
+
+def test_download_rejects_wrong_checksum_and_leaves_no_file(monkeypatch, tmp_path):
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(chunks=[b"tampered"]))
+    dest = tmp_path / "u.apk"
+    r = UpdateManager.download_apk(GOOD, str(dest), expected_sha256=SHA)
+    assert not r["success"] and "Checksum mismatch" in r["error"]
+    assert not dest.exists() and not Path(str(dest) + ".tmp").exists()
+
+def test_download_without_checksum_is_flagged_unverified(monkeypatch, tmp_path):
+    monkeypatch.setattr(um.requests, "get", lambda *a, **k: FakeResp(chunks=[b"data"]))
+    r = UpdateManager.download_apk(GOOD, str(tmp_path / "u.apk"))
+    assert r["success"] and r["verified"] is False
+
+def test_download_refuses_untrusted_url_without_touching_network(monkeypatch, tmp_path):
+    def boom(*a, **k): raise AssertionError("network must not be used")
+    monkeypatch.setattr(um.requests, "get", boom)
+    r = UpdateManager.download_apk("https://evil.example/a.apk", str(tmp_path / "u.apk"))
+    assert not r["success"] and "Refusing" in r["error"]
+
+
+# ---------------- single version source ----------------
+def test_version_has_a_single_source():
+    from app_version import __version__
+    assert re.fullmatch(r"\d+\.\d+\.\d+", __version__)
+    spec = (APP / "buildozer.spec").read_text()
+    assert "version.filename = %(source.dir)s/app_version.py" in spec
+    literal = re.compile(r"""['"]%s['"]""" % re.escape(__version__))
+    offenders = [str(p.relative_to(ROOT)) for p in list(APP.glob("*.py")) + list(APP.glob("services/*.py")) + list(APP.glob("screens/*.py"))
+                 if p.name != "app_version.py" and literal.search(p.read_text())]
+    assert offenders == [], f"version literal duplicated in {offenders}"
+
+def test_api_reports_the_single_version(tmp_path):
+    import services.postApi as P
+    from app_version import __version__
+    from fastapi.testclient import TestClient
+    assert TestClient(P.app).get("/health/").json()["version"] == __version__
+    assert P.app.version == __version__
+
+def test_removed_dead_flask_module_is_really_unused():
+    assert not (APP / "services" / "postFlask.py").exists()
+    for p in APP.rglob("*.py"):
+        assert "postFlask" not in p.read_text(), p
+
+
+# ---------------- PackageInstaller path (pure parts + fallback order) ----------------
+import pytest as _pytest
+
+
+@_pytest.mark.parametrize("status,kind", [(0, "success"), (-1, "pending"), (1, "error"), (2, "error"), (3, "error"),
+                                          (4, "error"), (5, "error"), (6, "error"), (7, "error"), (8, "error"), (99, "error")])
+def test_install_status_kinds(status, kind):
+    k, text = um.describe_install_status(status)
+    assert k == kind and text
+
+def test_install_conflict_explains_the_signature_problem_and_data_loss():
+    _, text = um.describe_install_status(5)
+    assert "signed" in text and "Uninstall" in text and "data is lost" in text
+    _, blocked = um.describe_install_status(2)
+    assert "Settings" in blocked
+
+def test_install_status_message_is_appended_only_for_errors():
+    assert "disk quota" in um.describe_install_status(6, " disk quota ")[1]
+    assert um.describe_install_status(0, "ignored")[1] == "Update installed."
+    assert um.describe_install_status(-1, "ignored")[0] == "pending"
+
+def test_copy_file_to_stream_chunks_and_counts(tmp_path):
+    data = bytes(range(256)) * 1000                                    # 256000 bytes
+    f = tmp_path / "a.apk"; f.write_bytes(data)
+    class Stream:
+        def __init__(self): self.calls = []; self.buf = b""
+        def write(self, chunk, offset, length):
+            assert offset == 0 and length == len(chunk); self.calls.append(length); self.buf += chunk
+    s = Stream()
+    assert um.copy_file_to_stream(str(f), s, chunk_size=65536) == len(data)
+    assert s.buf == data and len(s.calls) == 4 and max(s.calls) <= 65536
+    e = tmp_path / "empty.apk"; e.write_bytes(b"")
+    s2 = Stream(); assert um.copy_file_to_stream(str(e), s2) == 0 and s2.calls == []
+
+def test_install_apk_falls_back_when_package_installer_fails(monkeypatch, tmp_path):
+    f = tmp_path / "a.apk"; f.write_bytes(b"x")
+    calls = []
+    monkeypatch.setattr(um, "platform", "android")
+    def broken(path, cb): calls.append("package_installer"); raise RuntimeError("no jnius here")
+    monkeypatch.setattr(um, "_install_via_package_installer", broken)
+    import webbrowser
+    monkeypatch.setattr(webbrowser, "open", lambda url: calls.append(("browser", url)) or True)
+    r = UpdateManager.install_apk(str(f))
+    # package installer tried first; the ACTION_VIEW intent path cannot work off-device, so the browser fallback is reached
+    assert calls[0] == "package_installer" and calls[-1][0] == "browser"
+    assert r["success"] is False and "release page" in r["error"]
+
+def test_install_apk_reports_waiting_when_package_installer_starts(monkeypatch, tmp_path):
+    f = tmp_path / "a.apk"; f.write_bytes(b"x")
+    seen = []
+    monkeypatch.setattr(um, "platform", "android")
+    monkeypatch.setattr(um, "_install_via_package_installer", lambda path, cb: seen.append((path, cb)))
+    cb = lambda kind, text: None
+    r = UpdateManager.install_apk(str(f), on_status=cb)
+    assert r["success"] is True and seen == [(str(f), cb)]
+
+def test_install_apk_missing_file(tmp_path):
+    assert UpdateManager.install_apk(str(tmp_path / "nope.apk"))["success"] is False
+
+
+# ---------------- the new Java classes compile (against hand-written Android stubs) ----------------
+import shutil, subprocess, tempfile
+
+@_pytest.mark.skipif(shutil.which("javac") is None, reason="no JDK installed")
+def test_java_sources_compile_against_android_stubs():
+    stubs = {
+        "android/content/Context.java": "package android.content; public class Context {}",
+        "android/content/Intent.java": """package android.content; public class Intent {
+            public static final String EXTRA_INTENT = "android.intent.extra.INTENT";
+            public String getAction(){return null;} public String getStringExtra(String n){return null;}
+            public int getIntExtra(String n,int d){return d;} public byte[] getByteArrayExtra(String n){return null;}
+            public <T> T getParcelableExtra(String n, Class<T> c){return null;} public Object getParcelableExtra(String n){return null;} }""",
+        "android/content/BroadcastReceiver.java": "package android.content; public abstract class BroadcastReceiver { public abstract void onReceive(Context c, Intent i); public final int getResultCode(){return 0;} }",
+        "android/content/pm/PackageInstaller.java": """package android.content.pm; public class PackageInstaller {
+            public static final String EXTRA_STATUS="a"; public static final String EXTRA_STATUS_MESSAGE="b";
+            public static final int STATUS_FAILURE=1; public static final int STATUS_PENDING_USER_ACTION=-1; }""",
+        "android/os/Build.java": "package android.os; public class Build { public static class VERSION { public static int SDK_INT = 34; } }",
+        "android/telephony/SmsMessage.java": "package android.telephony; public class SmsMessage { public static SmsMessage createFromPdu(byte[] p, String f){return null;} public int getStatus(){return 0;} }",
+    }
+    with tempfile.TemporaryDirectory() as d:
+        for rel, src in stubs.items():
+            p = Path(d, "stubs", rel); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(src)
+        out = Path(d, "out"); out.mkdir()
+        sources = [str(p) for p in (APP / "java_src").rglob("*.java")]
+        r = subprocess.run(["javac", "-d", str(out), "-sourcepath", str(Path(d, "stubs")), *sources], capture_output=True, text=True)
+        assert r.returncode == 0, r.stderr
+        desc = subprocess.run(["javap", "-cp", str(out), "-s", "org.opensms.gateway.InstallResultListener"], capture_output=True, text=True).stdout
+        assert "(ILjava/lang/String;Landroid/content/Intent;)V" in desc               # matches @java_method in updateMgr
+        desc2 = subprocess.run(["javap", "-cp", str(out), "-s", "org.opensms.gateway.SmsResultListener"], capture_output=True, text=True).stdout
+        assert "(Ljava/lang/String;Ljava/lang/String;III)V" in desc2                  # matches @java_method in smsReceipts
diff -ruN -x __pycache__ -x .pytest_cache -x .ruff_cache orig_snapshot/tests/test_stage8_ipc.py repo/OpenSMS-main/tests/test_stage8_ipc.py
--- orig_snapshot/tests/test_stage8_ipc.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/OpenSMS-main/tests/test_stage8_ipc.py	2026-10-24 12:04:51.730121783 +0000
@@ -0,0 +1,130 @@
+"""ARCH-01: request-file watcher (no needless reads, back-off) and concurrent atomic writes."""
+import json, os, sys, threading
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "app"))
+from services.reqWatch import RequestWatcher
+from services.pathMgr import atomic_write_json
+
+
+def write(p, obj):
+    atomic_write_json(str(p), obj)
+
+
+def test_reads_only_when_the_file_changes(tmp_path):
+    p = tmp_path / "request.json"
+    w = RequestWatcher(str(p))
+    reads = []
+    orig = w._read
+    w._read = lambda: (reads.append(1), orig())[1]
+    assert w.poll() is None and reads == []                       # missing file: nothing to read
+    write(p, {"server": "start", "port": 9292})
+    assert w.poll() == {"server": "start", "port": 9292} and len(reads) == 1
+    for _ in range(50):
+        assert w.poll() is None                                  # unchanged: no read at all
+    assert len(reads) == 1
+    write(p, {"server": "stop", "port": 9292, "bind": "all"})    # different size -> detected
+    assert w.poll()["server"] == "stop" and len(reads) == 2
+
+def test_same_size_rewrite_is_detected_through_mtime(tmp_path):
+    p = tmp_path / "request.json"; w = RequestWatcher(str(p))
+    write(p, {"port": 1111}); assert w.poll() == {"port": 1111}
+    st = os.stat(p)
+    write(p, {"port": 2222})                                      # same byte length
+    os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns + 5_000_000))
+    assert w.poll() == {"port": 2222}
+
+def test_half_written_or_invalid_file_is_retried(tmp_path):
+    p = tmp_path / "request.json"; w = RequestWatcher(str(p))
+    p.write_text('{"server": "sta')                              # torn write
+    assert w.poll() is None
+    p.write_text('["not", "a", "dict"]')
+    assert w.poll() is None
+    write(p, {"server": "start"})
+    assert w.poll() == {"server": "start"}                       # recovered, nothing lost
+
+def test_polling_backs_off_when_idle_and_resets_on_activity(tmp_path):
+    now = [0.0]
+    p = tmp_path / "request.json"
+    w = RequestWatcher(str(p), fast=0.2, slow=1.0, idle_after=10.0, clock=lambda: now[0])
+    assert w.next_sleep() == 0.2
+    now[0] = 9.9; assert w.next_sleep() == 0.2
+    now[0] = 10.1; assert w.next_sleep() == 1.0                   # idle: poll slowly
+    write(p, {"server": "start"}); assert w.poll()                # a command arrives
+    assert w.next_sleep() == 0.2                                  # fast again
+    now[0] = 25.0; assert w.next_sleep() == 1.0
+
+def test_concurrent_writers_never_corrupt_the_file_or_leave_temp_files(tmp_path, capsys):
+    p = tmp_path / "config.json"
+    write(p, {"n": -1})
+    stop = threading.Event(); bad = []
+
+    def reader():
+        while not stop.is_set():
+            try:
+                json.loads(p.read_text())
+            except (ValueError, OSError) as e:
+                bad.append(repr(e))
+
+    def writer(i):
+        for j in range(40):
+            write(p, {"writer": i, "n": j, "pad": "x" * (i * 37)})
+
+    rt = threading.Thread(target=reader); rt.start()
+    ws = [threading.Thread(target=writer, args=(i,)) for i in range(12)]
+    [t.start() for t in ws]; [t.join() for t in ws]
+    stop.set(); rt.join()
+    assert bad == [], bad[:3]
+    assert "Error atomic writing" not in capsys.readouterr().out
+    assert sorted(x.name for x in tmp_path.iterdir()) == ["config.json"]       # no leftover .tmp files
+    assert json.loads(p.read_text())["n"] == 39
+
+def test_failed_write_cleans_up_its_temp_file(tmp_path, monkeypatch, capsys):
+    p = tmp_path / "x.json"
+    monkeypatch.setattr(os, "replace", lambda *a: (_ for _ in ()).throw(OSError("disk full")))
+    write(p, {"a": 1})
+    assert "Error atomic writing" in capsys.readouterr().out
+    assert list(tmp_path.iterdir()) == []
+
+
+# ---------------- the real service loop, end to end (subprocess: appSvc has import side effects) ----------------
+import socket, subprocess, textwrap
+APP = str(Path(__file__).resolve().parent.parent / "app")
+LOOP = textwrap.dedent('''
+    import sys, json, time, threading, socket
+    sys.path.insert(0, %r)
+    import services.appSvc as A
+    from services.pathMgr import atomic_write_json
+    port = int(sys.argv[1])
+    A._req_watcher.idle_after = 0.0                     # worst case: already in slow (1 s) polling mode
+    threading.Thread(target=A.app_service_thread, daemon=True).start()
+    def reach():
+        try:
+            socket.create_connection(("127.0.0.1", port), timeout=0.3).close(); return True
+        except OSError:
+            return False
+    def wait(cond, secs):
+        t0 = time.time()
+        while time.time() - t0 < secs:
+            if cond(): return round(time.time() - t0, 2)
+            time.sleep(0.05)
+        return None
+    atomic_write_json(A.req_file, {"server": "start", "port": port, "bind": "localhost"})
+    up = wait(reach, 8)
+    resp = json.load(open(A.resp_file)) if up is not None else {}
+    atomic_write_json(A.req_file, {"server": "stop", "port": port, "bind": "localhost"})
+    down = wait(lambda: not reach(), 8)
+    print("RESULT" + json.dumps({"up_after": up, "down_after": down, "resp_server": resp.get("server")}))
+''' % APP)
+
+
+def test_service_loop_starts_and_stops_the_server_from_the_request_file(tmp_path):
+    s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close()
+    env = {**os.environ, "HOME": str(tmp_path), "XDG_DATA_HOME": str(tmp_path), "OPENSMS_ALLOW_SIMULATION": "1"}
+    r = subprocess.run([sys.executable, "-c", LOOP, str(port)], capture_output=True, text=True, env=env, timeout=90, cwd=tmp_path)
+    line = [l for l in r.stdout.splitlines() if l.startswith("RESULT")]
+    assert line, r.stdout + r.stderr
+    out = json.loads(line[0][6:])
+    assert out["up_after"] is not None and out["up_after"] < 4, out          # command picked up despite slow polling
+    assert out["resp_server"] == "started"
+    assert out["down_after"] is not None and out["down_after"] < 4, out
diff -ruN -x __pycache__ -x .pytest_cache -x .ruff_cache orig_snapshot/tests/test_stage9_outbox.py repo/OpenSMS-main/tests/test_stage9_outbox.py
--- orig_snapshot/tests/test_stage9_outbox.py	1970-01-01 00:00:00.000000000 +0000
+++ repo/OpenSMS-main/tests/test_stage9_outbox.py	2026-10-24 12:11:27.047671068 +0000
@@ -0,0 +1,165 @@
+"""In-app sending goes through the service queue (outbox): safety, idempotency and an end-to-end run."""
+import json, os, subprocess, sys, textwrap, time
+from pathlib import Path
+import pytest
+
+APP = str(Path(__file__).resolve().parent.parent / "app")
+sys.path.insert(0, APP)
+
+import services.postApi as P
+from services.outbox import write_outbox, drain_outbox, OutboxRetry, outbox_dir, validate_outgoing
+from services import messageSvc
+from services.smsApi import SubmitResult
+
+
+@pytest.fixture(autouse=True)
+def cfg(tmp_path):
+    d = tmp_path / "config"; d.mkdir()
+    P.set_config_path(str(d))
+    yield str(d)
+    P.message_svc.stop()
+
+
+def wait_status(mid, wanted, secs=5):
+    t0 = time.time()
+    while time.time() - t0 < secs:
+        m = P.db_mgr.get_message(mid)
+        if m and m["status"] in wanted:
+            return m
+        time.sleep(0.05)
+    return P.db_mgr.get_message(mid)
+
+
+# ---------------- writing ----------------
+def test_write_validates_like_the_api(cfg):
+    for bad_number, bad_text in [("abc", "hi"), ("", "hi"), ("+94771234567", ""), ("+94771234567", "   "), ("+94771234567", "x" * 1601)]:
+        with pytest.raises(ValueError):
+            write_outbox(cfg, bad_number, bad_text)
+    assert not os.path.exists(outbox_dir(cfg)) or os.listdir(outbox_dir(cfg)) == []
+    mid = write_outbox(cfg, "+94 77 123-4567", "hello")
+    payload = json.load(open(os.path.join(outbox_dir(cfg), f"{mid}.json")))
+    assert payload["number"].replace(" ", "").replace("-", "") == "+94771234567" and payload["text"] == "hello"   # formatting is cleaned at send time, as in the API
+    assert validate_outgoing("+94771234567", "ok")[2] is None
+    assert validate_outgoing("zz", "ok")[2]                       # an explanation, not an exception
+
+
+# ---------------- draining ----------------
+def test_drain_consumes_and_removes_items(cfg):
+    ids = [write_outbox(cfg, "+94771234567", f"m{i}") for i in range(3)]
+    seen = []
+    assert drain_outbox(cfg, lambda p: seen.append(p["id"])) == 3
+    assert sorted(seen) == sorted(ids) and os.listdir(outbox_dir(cfg)) == []
+
+def test_partial_files_are_ignored_and_malformed_ones_quarantined(cfg):
+    os.makedirs(outbox_dir(cfg), exist_ok=True)
+    Path(outbox_dir(cfg), "x.123.4.tmp").write_text('{"id": "half')               # an in-progress atomic write
+    Path(outbox_dir(cfg), "broken.json").write_text("{not json")
+    Path(outbox_dir(cfg), "list.json").write_text("[1,2]")
+    seen = []
+    assert drain_outbox(cfg, seen.append) == 0 and seen == []
+    names = sorted(os.listdir(outbox_dir(cfg)))
+    assert names == ["broken.bad", "list.bad", "x.123.4.tmp"]                      # nothing retried forever, nothing lost silently
+
+def test_retry_keeps_the_file_and_order(cfg):
+    write_outbox(cfg, "+94771234567", "first"); time.sleep(0.01); write_outbox(cfg, "+94771234567", "second")
+    calls = []
+    def handler(p):
+        calls.append(p["text"])
+        raise OutboxRetry()
+    assert drain_outbox(cfg, handler) == 0
+    assert calls == [calls[0]] and len(os.listdir(outbox_dir(cfg))) == 2          # stopped at the first, kept both
+    assert drain_outbox(cfg, lambda p: None) == 2
+
+def test_handler_exception_quarantines_only_that_item(cfg):
+    write_outbox(cfg, "+94771234567", "boom"); time.sleep(0.01); write_outbox(cfg, "+94771234567", "fine")
+    seen = []
+    def handler(p):
+        if p["text"] == "boom":
+            raise RuntimeError("bad item")
+        seen.append(p["text"])
+    assert drain_outbox(cfg, handler) == 1 and seen == ["fine"]
+    assert sorted(n.rsplit(".", 1)[1] for n in os.listdir(outbox_dir(cfg))) == ["bad"]
+
+
+# ---------------- acceptance into the pipeline ----------------
+def test_accepted_message_flows_through_the_normal_lifecycle(cfg):
+    mid = write_outbox(cfg, "+94771234567", "from the app")
+    assert drain_outbox(cfg, P.accept_local_message) == 1
+    m = wait_status(mid, {"sent", "submitted", "failed"})
+    assert m["status"] == "sent" and m["provider"] == "simulated" and m["recipient"] == "+94771234567"
+    assert P.db_mgr.get_parts(mid)[0]["sent_ok"] == 1                              # receipts bookkeeping exists
+
+def test_crash_between_accept_and_file_removal_never_sends_twice(cfg):
+    calls = []
+    class Counting:
+        name = "android"; supports_receipts = True
+        def submit(self, msg_id, phone, text, sim_slot=-1):
+            calls.append(msg_id); return SubmitResult(True, parts=1)
+    P.message_svc.provider = Counting()
+    mid = write_outbox(cfg, "+94771234567", "once")
+    path = os.path.join(outbox_dir(cfg), f"{mid}.json")
+    payload = json.load(open(path))
+    P.accept_local_message(payload)                                                # accepted ...
+    wait_status(mid, {"submitted"})
+    assert os.path.exists(path)                                                    # ... but the file was never removed (crash)
+    assert drain_outbox(cfg, P.accept_local_message) == 1                          # restart: file is seen again
+    time.sleep(0.3)
+    assert calls == [mid] and P.db_mgr.count_messages() == 1                       # still exactly one send, one row
+
+def test_inactive_sim_becomes_a_failed_row_with_the_reason(cfg):
+    class Never:
+        name = "android"; supports_receipts = True
+        def submit(self, *a, **k): raise AssertionError("must not be called")
+    P.message_svc.provider = Never()
+    mid = write_outbox(cfg, "+94771234567", "x", sim_slot=7)
+    assert drain_outbox(cfg, P.accept_local_message) == 1
+    m = P.db_mgr.get_message(mid)
+    assert m["status"] == "failed" and "SIM slot 7" in m["carrier_error"]
+
+def test_full_queue_leaves_the_file_for_a_later_pass(cfg, monkeypatch):
+    monkeypatch.setattr(messageSvc, "QUEUE_MAX", 0)
+    mid = write_outbox(cfg, "+94771234567", "later")
+    assert drain_outbox(cfg, P.accept_local_message) == 0
+    assert os.path.exists(os.path.join(outbox_dir(cfg), f"{mid}.json")) and P.db_mgr.count_messages() == 0
+    monkeypatch.setattr(messageSvc, "QUEUE_MAX", 1000)
+    assert drain_outbox(cfg, P.accept_local_message) == 1 and P.db_mgr.count_messages() == 1
+
+def test_foreign_or_bad_ids_cannot_collide_with_existing_messages(cfg):
+    existing = P.db_mgr.create_message("+94770000001", "old", status="delivered", provider="android")
+    assert drain_outbox(cfg, P.accept_local_message) == 0
+    os.makedirs(outbox_dir(cfg), exist_ok=True)
+    Path(outbox_dir(cfg), "x.json").write_text(json.dumps({"id": "not-a-uuid", "number": "+94771234567", "text": "hi"}))
+    assert drain_outbox(cfg, P.accept_local_message) == 1                          # bad id -> a fresh uuid, not a crash
+    assert P.db_mgr.get_message(existing)["status"] == "delivered"                 # untouched
+    assert P.db_mgr.count_messages() == 2
+
+
+# ---------------- end to end through the real service loop ----------------
+LOOP = textwrap.dedent('''
+    import sys, json, time, threading, uuid
+    sys.path.insert(0, %r)
+    import services.appSvc as A
+    from services.outbox import write_outbox
+    from services.dbMgr import DatabaseManager
+    threading.Thread(target=A.app_service_thread, daemon=True).start()
+    time.sleep(1.0)
+    ids = [write_outbox(A.config_dir, "+94771234567", f"e2e {i}") for i in range(3)]
+    db = DatabaseManager.get_instance(A.config_dir)
+    t0 = time.time(); out = {}
+    while time.time() - t0 < 12:
+        out = {i: (db.get_message(i) or {}).get("status") for i in ids}
+        if all(v == "sent" for v in out.values()): break
+        time.sleep(0.1)
+    import os
+    left = [n for n in os.listdir(os.path.join(A.config_dir, "outbox"))]
+    print("RESULT" + json.dumps({"statuses": list(out.values()), "left": left, "took": round(time.time() - t0, 2)}))
+''' % APP)
+
+
+def test_service_loop_delivers_in_app_messages_end_to_end(tmp_path):
+    env = {**os.environ, "HOME": str(tmp_path), "XDG_DATA_HOME": str(tmp_path), "OPENSMS_ALLOW_SIMULATION": "1"}
+    r = subprocess.run([sys.executable, "-c", LOOP], capture_output=True, text=True, env=env, timeout=90, cwd=tmp_path)
+    line = [l for l in r.stdout.splitlines() if l.startswith("RESULT")]
+    assert line, r.stdout + r.stderr
+    out = json.loads(line[0][6:])
+    assert out["statuses"] == ["sent", "sent", "sent"] and out["left"] == [], out
diff -ruN -x __pycache__ -x .pytest_cache -x .ruff_cache orig_snapshot/tests/test_ui_icons.py repo/OpenSMS-main/tests/test_ui_icons.py
