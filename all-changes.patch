+def valid_key_name(name: str) -> Optional[str]:
+    """Return an error message, or None when the name is acceptable."""
+    name = (name or "").strip()
+    if not name:
+        return "Enter a name so you can recognise this key later."
+    if len(name) > 64:
+        return "Use at most 64 characters."
+    return None
