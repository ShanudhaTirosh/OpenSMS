#:import parse_color kivy.parser.parse_color
#:import AppHomeBox screens.mainScr.AppHomeBox
#:import SettingsBox screens.settings.SettingsBox
#:import LogBox screens.logs.LogBox
#:import TailscaleBox screens.tailscaleScr.TailscaleBox

<BaseMDNavigationItem>
    MDNavigationItemIcon:
        icon: root.icon
    MDNavigationItemLabel:
        text: root.text

MDScreen:
    md_bg_color: self.theme_cls.backgroundColor

    MainScreenBox: # main container
        id: main_scr_box
        orientation: 'vertical'
        padding: 0 , self.top_pad, 0, 0

        MDTopAppBar:
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: [0.06, 0.16, 0.32, 1] if app.theme_style == "Light" else [0.08, 0.12, 0.20, 1]
            pos_hint: {"top": 1}

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "menu"
                    color: "white"
                    on_release: app.toggle_nav_drawer()
                MDActionTopAppBarButton:
                    id: top_back_btn
                    icon: "arrow-left"
                    color: "white"
                    opacity: 0
                    disabled: True
                    on_release: app.back_button_action()
            MDTopAppBarTitle:
                text: app.screen_title
                color: "white"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    id: right_dot_menu
                    icon: "dots-vertical"
                    color: "white"
                    opacity: 0
                    disabled: True
                    on_release: log_scr.show_top_menu(self)

        MDFloatLayout:

            MDNavigationLayout:

                MDScreenManager:
                    id: screen_manager

                    MDScreen:
                        name: "SMS"
                        on_enter: app.on_main_screen_entry()
                        AppHomeBox:
                            id: home_scr
                            padding: 8, 2, 8, (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Mesh"
                        on_enter: app.on_tailscale_screen_entry()
                        TailscaleBox:
                            id: tailscale_scr
                            padding: 8, 2, 8, (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Settings"
                        on_enter: app.on_settings_entry()
                        SettingsBox:
                            id: settings_scr
                            padding: 8, 2, 8, (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Logs"
                        on_enter: app.on_logs_screen_entry(right_dot_menu, top_back_btn)
                        on_leave: log_scr.on_log_scr_exit(right_dot_menu, top_back_btn)
                        LogBox:
                            id: log_scr
                            padding: 8, 2, 8, (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                MDNavigationDrawer:
                    id: nav_drawer
                    radius: 0, dp(16), dp(16), 0

                    MDNavigationDrawerMenu:
                        MDNavigationDrawerLabel:
                            text: "OpenSMS Gateway"

                        MDNavigationDrawerItem:
                            on_release: app.go_to_screen("SMS")
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "cellphone-wireless"
                            MDNavigationDrawerItemText:
                                text: "SMS Gateway"

                        MDNavigationDrawerItem:
                            on_release: app.goto_tailscale_screen()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "shield-account-outline"
                            MDNavigationDrawerItemText:
                                text: "Remote Mesh (Tailscale)"

                        MDNavigationDrawerItem:
                            on_release: app.goto_logs_screen()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "format-list-bulleted"
                            MDNavigationDrawerItemText:
                                text: "API Traffic Logs"

                        MDNavigationDrawerItem:
                            on_release: app.go_to_screen("Settings")
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "cog-outline"
                            MDNavigationDrawerItemText:
                                text: "Settings & Power"

                        MDNavigationDrawerDivider:

                        MDNavigationDrawerLabel:
                            text: "Tools & Actions"

                        MDNavigationDrawerItem:
                            on_release: app.open_test_sms_from_drawer()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "message-plus"
                            MDNavigationDrawerItemText:
                                text: "Send Test SMS"

                        MDNavigationDrawerItem:
                            on_release: app.copy_endpoint_url_from_drawer()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "content-copy"
                            MDNavigationDrawerItemText:
                                text: "Copy Gateway URL"

                        MDNavigationDrawerItem:
                            on_release: app.toggle_theme_from_drawer()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "theme-light-dark"
                            MDNavigationDrawerItemText:
                                text: "Toggle Dark Theme"

                        MDNavigationDrawerItem:
                            on_release: app.check_for_updates_from_drawer()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "cloud-search-outline"
                            MDNavigationDrawerItemText:
                                text: "Check for Updates"

                        MDNavigationDrawerItem:
                            on_release: app.open_about_from_drawer()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "information-outline"
                            MDNavigationDrawerItemText:
                                text: "About OpenSMS"

            MDNavigationBar:
                id: btm_nav_bar
                pos: 0, main_scr_box.bottom_pad
                on_switch_tabs: app.on_switch_tabs(*args)

                BaseMDNavigationItem
                    icon: "cellphone-wireless"
                    text: "SMS"
                    active: True

                BaseMDNavigationItem
                    icon: "shield-account-outline"
                    text: "Mesh"

                BaseMDNavigationItem
                    icon: "cog-outline"
                    text: "Settings"
