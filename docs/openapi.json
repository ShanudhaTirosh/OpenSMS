    "/keys/": {
      "get": {
        "description": "Needs scope `admin`. Never returns key secrets or hashes.",
        "operationId": "list_keys_keys__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
