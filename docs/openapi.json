    "/sms/": {
      "post": {
        "description": "Needs scope `sms:write`. Returns 200 after the hand-off to Android (`status` submitted/sent), 202 if still queued. `status: delivered` is the only delivery confirmation. Supports the `Idempotency-Key` header.",
        "operationId": "process_sms_req_sms__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsData"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Send one SMS"
      }
    },
    "/sms/batch/": {
      "post": {
        "description": "Needs scope `sms:write`. Per-message results; supports the `Idempotency-Key` header.",
        "operationId": "process_batch_sms_req_sms_batch__post",
        "requestBody": {
          "content": {
            "application/json": {
