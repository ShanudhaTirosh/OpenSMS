  "servers": [
    {
      "description": "Active Android OpenSMS Gateway",
      "url": "http://{device_ip}:{port}",
      "variables": {
        "device_ip": {
          "default": "127.0.0.1",
          "description": "IP address of the Android phone (Wi-Fi, Tailscale 100.x.y.z, or Localhost)"
        },
        "port": {
          "default": "9292",
          "description": "Configured gateway port (default: 9292)"
        }
      }
