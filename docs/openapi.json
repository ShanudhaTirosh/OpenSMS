{
  "components": {
    "schemas": {
      "BatchSmsData": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/SmsData"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "BatchSmsData",
        "type": "object"
      },
      "ControlData": {
        "properties": {
          "api": {
            "title": "Api",
            "type": "string"
          }
        },
        "required": [
          "api"
        ],
        "title": "ControlData",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NewKeyData": {
        "properties": {
          "name": {
            "default": "API Key",
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "default": [
              "sms:write",
              "sms:read"
            ],
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "title": "NewKeyData",
        "type": "object"
      },
      "SmsData": {
        "properties": {
          "number": {
            "title": "Number",
            "type": "string"
          },
          "sim_slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sim Slot"
          },
          "sub_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Text"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "number",
          "text"
        ],
        "title": "SmsData",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
